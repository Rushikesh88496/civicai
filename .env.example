# Database (local PostgreSQL 17, port 5433)
# URL-encode any special characters in the password (e.g. '#' -> %23, '@' -> %40)
DATABASE_URL=postgresql+asyncpg://civicagent:YOUR_CIVICAGENT_PASSWORD@localhost:5433/civicagent

# Redis (Redis runs separately via Docker or local)
REDIS_URL=redis://localhost:6379/0

# Security
JWT_SECRET=your-jwt-secret-here

# AI / LLM (Groq)
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama3-70b-8192

# Storage
STORAGE_BACKEND=local
STORAGE_BUCKET=civicagent-uploads

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000

# CORS
CORS_ORIGINS=http://localhost:3000

# Notifications email (Part 21) — console provider needs no credentials.
# Set EMAIL_PROVIDER=smtp and fill SMTP_* only when real credentials exist.
EMAIL_PROVIDER=console
EMAIL_FROM=CivicAgent <no-reply@civicagent.local>
NOTIFICATIONS_EMAIL_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true

# Development
DEBUG=false