# ===========================================================================
# CivicAgent — environment reference
#
# Copy this file to `.env` at the repository root and fill in the values.
#   cp .env.example .env
#
# The backend also reads a `backend/.env` if present (same variable names).
# NEVER commit your real `.env`. This file is a template only.
# ===========================================================================

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# FastAPI app name, version and API prefix (usually left as-is).
PROJECT_NAME=CivicAgent
VERSION=0.1.0
API_V1_PREFIX=/api/v1
# Set true to enable the interactive /docs (Swagger UI) and /redoc pages,
# handy for local development. Keep false in production.
DEBUG=false

# ---------------------------------------------------------------------------
# REQUIRED — Security
# ---------------------------------------------------------------------------
# JWT signing secret (HS256 requires at least 32 bytes, RFC 7518).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-32-bytes-minimum-paste-a-token-urlsafe-value-here

# ---------------------------------------------------------------------------
# REQUIRED for AI — Groq LLM / vision (console.groq.com/keys)
# ---------------------------------------------------------------------------#
# The API key is read from the environment only. Never log it, never expose it
# to the browser.
GROQ_API_KEY=
# Chat / structured-output model (a currently-available Groq model).
GROQ_MODEL=openai/gpt-oss-120b
# Per-request timeout (seconds) and retry budget for Groq AI calls.
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2
# Log level for the AI service: INFO (default), DEBUG, or WARNING.
GROQ_LOG_LEVEL=INFO
# Vision / multimodal evidence-analysis provider. Only "groq" is supported today
# and it reuses GROQ_API_KEY above.
VISION_PROVIDER=groq
# Multimodal model that accepts image inputs (verified against Groq's model list).
VISION_MODEL=qwen/qwen3.6-27b
# Max image payload (MB) forwarded to the vision provider.
VISION_MAX_IMAGE_MB=10
# Longer per-request timeout used for image analysis.
VISION_TIMEOUT_SECONDS=60

# ---------------------------------------------------------------------------
# Database — see docs/database.md
# ---------------------------------------------------------------------------
# URL-encode special characters in passwords (e.g. '#' -> %23, '@' -> %40).
# Local reference install, PostgreSQL 17 on port 5433:
DATABASE_URL=postgresql+asyncpg://civicagent:civicagent@localhost:5433/civicagent
# In the Compose network the host is `postgres` on port 5432:
# DATABASE_URL=postgresql+asyncpg://civicagent:civicagent@postgres:5432/civicagent

# Redis (pub/sub for realtime notifications + external-API response cache).
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Media / uploads
# ---------------------------------------------------------------------------#
MAX_IMAGE_MB=10
MAX_VIDEO_MB=50
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
ALLOWED_VIDEO_TYPES=video/mp4,video/webm,video/quicktime
# TTL (seconds) of the short-lived HMAC token appended to locally-served /media
# URLs (browser <img>/<video> tags cannot send Authorization headers).
MEDIA_ACCESS_TTL_SECONDS=900
MEDIA_ACCESS_SKEW_SECONDS=30

# ---------------------------------------------------------------------------
# Object storage
# ---------------------------------------------------------------------------
# "local" writes uploads to STORAGE_LOCAL_DIR (no external service).
# "s3" uses a MinIO / S3-compatible bucket (see S3_* and docker-compose.minio.yml).
STORAGE_BACKEND=local
STORAGE_BUCKET=civicagent-uploads
STORAGE_LOCAL_DIR=uploads

# S3 / MinIO-compatible object storage (used when STORAGE_BACKEND=s3).
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_SECURE=false
# Public base URL for media retrieval. Must allow anonymous GET of that path
# (download-only bucket policy). Example for the Compose MinIO service:
# S3_PUBLIC_BASE_URL=http://localhost:9000/civicagent-uploads
S3_PUBLIC_BASE_URL=

# ---------------------------------------------------------------------------
# CORS / Security headers
# ---------------------------------------------------------------------------
# Comma-separated frontend origins allowed to call the API.
CORS_ORIGINS=http://localhost:3000
# Rate-limiting switch for the slowapi limiter. Tests disable this.
RATE_LIMIT_ENABLED=true

# ---------------------------------------------------------------------------
# AI — duplicate / incident correlation (Part 9)
# ---------------------------------------------------------------------------
# Local Sentence-Transformers model (fastembed). BGE-small is fully offline and
# produces 384-dim vectors — no API key required.
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384
EMBEDDING_CACHE_DIR=
CORRELATION_SIMILARITY_THRESHOLD=0.72
CORRELATION_NEARBY_RADIUS_M=500
CORRELATION_MAX_CANDIDATES=5
CORRELATION_TIME_WINDOW_HOURS=168
CORRELATION_COMBINED_THRESHOLD=0.6

# ---------------------------------------------------------------------------
# AI — GIS ward detection & spatial intelligence (Part 10)
# ---------------------------------------------------------------------------
# Reverse geocoding uses OpenStreetMap's public Nominatim service (NO API key).
# It enforces fair-use rate limits; lookups degrade gracefully on failure.
GIS_BASE_URL=https://nominatim.openstreetmap.org
GIS_NOMINATIM_USERAGENT=CivicAgent/0.1 (civic-complaints-demo)
GIS_NOMINATIM_TIMEOUT_SECONDS=8.0
GIS_NOMINATIM_MAX_RETRIES=2
GIS_DEFAULT_RADIUS_M=500
GIS_MAX_RADIUS_M=5000
GIS_CRITICAL_RADIUS_M=1500
GIS_DEMO_LABEL=DEMO DATA

# ---------------------------------------------------------------------------
# AI — Context Enrichment Agent (Part 11)
# ---------------------------------------------------------------------------
# Weather comes from Open-Meteo's public forecast API (NO API key required for
# /v1/forecast) — do not add a key here.
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_SECONDS=10.0
WEATHER_MAX_RETRIES=2
WEATHER_FORECAST_DAYS=3
WEATHER_CACHE_TTL_SECONDS=1800
WEATHER_CACHE_ENABLED=true
CONTEXT_CACHE_NAMESPACE=civicagent:context
CONTEXT_HISTORICAL_WINDOW_HOURS=168.0
CONTEXT_HISTORICAL_RADIUS_M=1000.0

# ---------------------------------------------------------------------------
# AI — Dynamic Priority & Risk Engine (Part 12)
# ---------------------------------------------------------------------------
# Deterministic weighted scoring; the engine NEVER lets an LLM set the numeric
# score. Each input is normalized to 0..1 then weighted; total = sum * 100.
PRIORITY_WEIGHT_SEVERITY=0.30
PRIORITY_WEIGHT_WEATHER=0.10
PRIORITY_WEIGHT_LOCATION=0.15
PRIORITY_WEIGHT_CROWD=0.20
PRIORITY_WEIGHT_HISTORY=0.10
PRIORITY_WEIGHT_TIME=0.15
# Bucket boundaries (inclusive upper cutoff):
# [80,100]->P1_CRITICAL, [60,80)->P2_HIGH, [40,60)->P3_MEDIUM, [0,40)->P4_LOW.
PRIORITY_THRESHOLD_P1=80.0
PRIORITY_THRESHOLD_P2=60.0
PRIORITY_THRESHOLD_P3=40.0
# A recomputation is flagged "changed" (and recorded in history) when the score
# moves by at least this many points.
PRIORITY_CHANGE_THRESHOLD=15.0
# Weather / population / complaint / history / time normalization bands.
PRIORITY_WEATHER_RAIN_MM=5.0
PRIORITY_POPULATION_BAND=1000.0
PRIORITY_COMPLAINT_BAND=10.0
PRIORITY_HISTORY_BAND=15.0
PRIORITY_TIME_BAND_HOURS=168.0

# ---------------------------------------------------------------------------
# AI — Department Routing Agent (Part 13)
# ---------------------------------------------------------------------------
# Deterministic rule-based routing to the seven fixed departments
# (WATER, ROADS, ELECTRICAL, WASTE, DRAINAGE, PARKS, EMERGENCY_DISASTER). The
# engine NEVER lets an LLM choose the department.
ROUTING_CONFIDENCE_UNKNOWN=0.30
ROUTING_CONFIDENCE_KNOWN=0.92
ROUTING_CONFIDENCE_MULTI=0.85
ROUTING_CONFIDENCE_PRIORITY_BOOST=0.03
ROUTING_MAX_SECONDARY_DEPARTMENTS=2
ROUTING_OVERRIDE_ENABLED=true

# ---------------------------------------------------------------------------
# AI — Work Orders & Autonomous Dispatch (Part 14)
# ---------------------------------------------------------------------------
# Deterministic scored worker selection (weights should sum to ~1.0).
DISPATCH_WEIGHT_AVAILABILITY=0.30
DISPATCH_WEIGHT_SKILL=0.25
DISPATCH_WEIGHT_DISTANCE=0.20
DISPATCH_WEIGHT_WORKLOAD=0.15
DISPATCH_WEIGHT_EQUIPMENT=0.10
DISPATCH_WEIGHT_DEPARTMENT=0.10
DISPATCH_WEIGHT_WARD=0.10
DISPATCH_WEIGHT_PRIORITY=0.05
DISPATCH_PRIORITY_URGENCY_BOOST=0.05
DISPATCH_MAX_ACTIVE_ORDERS=3
DISPATCH_MAX_CANDIDATES=5
DISPATCH_DISTANCE_REF_KILOMETERS=20.0
# Fallback average travel speed (km/h) used only for the documented estimated
# ETA when no live routing provider is configured. ETA is always labelled live|estimated.
DISPATCH_EST_AVG_SPEED_KMH=25.0
# Optional live routing provider (leave URL empty to always use estimates).
ROUTING_API_URL=
ROUTING_API_KEY=
DISPATCH_ENABLED=true

# ---------------------------------------------------------------------------
# AI — Resolution Verification (Part 8 / Part 19)
# ---------------------------------------------------------------------------
# Model used to compare BEFORE/AFTER photos. Empty reuses VISION_MODEL
# (no additional API key needed — it reuses GROQ_API_KEY).
VERIFICATION_MODEL=
# Confidence floors. Below LOW the verdict is forced to NEEDS_HUMAN_REVIEW; a
# VERIFIED result must clear VERIFIED_MIN_CONFIDENCE to be auto-trusted.
VERIFICATION_LOW_CONFIDENCE=0.55
VERIFICATION_VERIFIED_MIN_CONFIDENCE=0.75
# Safety gate: P1_CRITICAL work orders always require authorized human sign-off
# even with a high-confidence VERIFIED result.
VERIFICATION_HUMAN_REVIEW_CRITICAL=true

# ---------------------------------------------------------------------------
# AI — Predictive Civic Hotspots (Part 23 / Part 36) and Infra (Part 24)
# ---------------------------------------------------------------------------
# ML models are trained/served ONLY once the platform holds a minimum amount of
# REAL operational data; otherwise every ML surface reports INSUFFICIENT_DATA.
MINIMUM_TRAINING_RECORDS=25
MINIMUM_AREA_TIME_OBSERVATIONS=15
ML_GATING_LOOKBACK_DAYS=365
INFRA_MIN_ASSETS=5

HOTSPOT_CELL_DEG=0.01
# City bounding box (min_lat,min_lon,max_lat,max_lon). Pune operational zones.
HOTSPOT_BBOX=18.42,73.78,18.60,73.96
HOTSPOT_HORIZON_DAYS=7
HOTSPOT_TRAIN_LOOKBACK_DAYS=730
HOTSPOT_TRAIN_SEED=20260906
HOTSPOT_SNAPSHOT_EVERY_DAYS=2
HOTSPOT_TEST_FINAL_DAYS=180
HOTSPOT_CV_FOLDS=3
HOTSPOT_EXTERNAL_DROPOUT=0.25
HOTSPOT_ARTIFACT_DIR=app/ml/artifacts
# When true, live prediction pulls current Open-Meteo precipitation (cached);
# otherwise rainfall is reported unavailable (0.0) — the safe offline default.
HOTSPOT_RAINFALL_FETCH=false
HOTSPOT_N_ESTIMATORS=300
HOTSPOT_MAX_DEPTH=6
HOTSPOT_LEARNING_RATE=0.05

INFRA_ARTIFACT_DIR=app/ml/artifacts
INFRA_CORPUS_YEARS=2
INFRA_CORPUS_SEED=20260907
INFRA_CORPUS_ASSETS=120
INFRA_SNAPSHOT_EVERY_DAYS=14
INFRA_HORIZON_DAYS=30
INFRA_TEST_FINAL_DAYS=240
INFRA_CV_FOLDS=3
INFRA_EXTERNAL_DROPOUT=0.25
INFRA_RADIUS_M=500
INFRA_COMPLAINTS_LOOKBACK_DAYS=90
INFRA_REPAIRS_LOOKBACK_DAYS=365
# Risk bands on failure_probability: <0.25 LOW, <0.50 MEDIUM, <0.75 HIGH, >=0.75 CRITICAL.
INFRA_RISK_MEDIUM=0.25
INFRA_RISK_HIGH=0.50
INFRA_RISK_CRITICAL=0.75
INFRA_RAINFALL_FETCH=false
INFRA_N_ESTIMATORS=300
INFRA_MAX_DEPTH=6
INFRA_LEARNING_RATE=0.05

# ---------------------------------------------------------------------------
# AI — Citizen Assistant & RAG (Part 25)
# ---------------------------------------------------------------------------
# Model used to answer assistant questions. Empty reuses GROQ_MODEL.
ASSISTANT_MODEL=
ASSISTANT_MAX_TOKENS=500
ASSISTANT_TOP_K=4
# Below this similarity the assistant answers from general knowledge with an
# explicit "I don't have official policy for this" caveat (anti-hallucination).
ASSISTANT_MIN_SIMILARITY=0.20
ASSISTANT_HISTORY_TURNS=6
ASSISTANT_TEMPERATURE=0.2

# ---------------------------------------------------------------------------
# Notifications / Email (Part 21)
# ---------------------------------------------------------------------------
# "console" logs emails only (no credentials required — the safe default).
# "smtp" sends real mail via stdlib smtplib; supply SMTP_* credentials.
EMAIL_PROVIDER=console
EMAIL_FROM=CivicAgent <no-reply@civicagent.local>
# When true, channel="email" notifications are also emailed. Off by default;
# flip on only after SMTP credentials exist.
NOTIFICATIONS_EMAIL_ENABLED=false
# SMTP server settings (only used when EMAIL_PROVIDER=smtp).
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_TIMEOUT_SECONDS=30.0
# Realtime fallback poll interval (seconds) pushed to WS clients, and page size
# for the paginated notifications listing.
NOTIFICATIONS_WS_FALLBACK_SECONDS=30
NOTIFICATIONS_PAGE_SIZE=50

# ---------------------------------------------------------------------------
# Frontend (build-time)
# ---------------------------------------------------------------------------
# Base URL of the CivicAgent backend API, inlined into the browser bundle at
# build time. Must be reachable from the visitor's browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# ---------------------------------------------------------------------------
# Docker Compose extras (see infrastructure/.env.docker.example)
# ---------------------------------------------------------------------------
# Host ports mapped by Compose.
BACKEND_PORT=8000
FRONTEND_PORT=3000
# Dev override maps Postgres here (avoids a local PG on 5432).
POSTGRES_HOST_PORT=5433
# Demo seed is for dev/test only. Never enable in production.
SEED_DEMO_DATA=false
# Database credentials used by the Compose Postgres service.
POSTGRES_DB=civicagent
POSTGRES_USER=civicagent
POSTGRES_PASSWORD=civicagent
# Optional MinIO/S3 (see docker-compose.minio.yml + "Object storage" above).
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin