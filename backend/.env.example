# Database (local PostgreSQL 17, port 5433)
# URL-encode any special characters in the password (e.g. '#' -> %23, '@' -> %40)
DATABASE_URL=postgresql+asyncpg://civicagent:YOUR_CIVICAGENT_PASSWORD@localhost:5433/civicagent

# Redis (if a local Redis or Docker Redis is running)
REDIS_URL=redis://localhost:6379/0

# Security
# At least 32 bytes for HS256 (RFC 7518). Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=your-32+-byte-jwt-secret-here

# AI / LLM (Groq)
# Get a key from https://console.groq.com/keys (the API key is read from the
# environment only; it is never logged and never exposed to the browser).
GROQ_API_KEY=your-groq-api-key-here
# Chat/structured model. Verify current availability with `groq.models.list()`.
GROQ_MODEL=openai/gpt-oss-120b
# Per-request timeout (seconds) and retry budget for Groq calls.
GROQ_TIMEOUT_SECONDS=30
GROQ_MAX_RETRIES=2
# Log level for the AI service: INFO (default), DEBUG, or WARNING.
GROQ_LOG_LEVEL=INFO

# Vision / multimodal evidence verification (Part 8)
# Provider reused for image analysis. Only "groq" is supported; it uses the same
# GROQ_API_KEY above. Set VISION_PROVIDER to a different provider only after
# supplying its own API key env var (otherwise the agent fails cleanly).
VISION_PROVIDER=groq
# Multimodal model that accepts image inputs. Always confirm this model id
# against ``client.models.list()`` for the actual API key before changing it.
# qwen/qwen3.8-27b is the vision-capable model confirmed for this Groq account.
VISION_MODEL=qwen/qwen3.8-27b
# Max image payload (MB) forwarded to the vision provider.
VISION_MAX_IMAGE_MB=10
# Longer per-request timeout for image analysis.
VISION_TIMEOUT_SECONDS=60

# Storage
# "local" writes uploads to disk under STORAGE_LOCAL_DIR (no external service).
# "s3" stores objects in a MinIO / S3-compatible bucket (see S3_* below).
STORAGE_BACKEND=local
STORAGE_BUCKET=civicagent-uploads
# Directory (relative to backend/) used by the "local" backend.
STORAGE_LOCAL_DIR=uploads

# S3 / MinIO-compatible object storage (used when STORAGE_BACKEND=s3).
# Local MinIO example:
#   S3_ENDPOINT_URL=http://localhost:9000
#   S3_ACCESS_KEY=minioadmin
#   S3_SECRET_KEY=minioadmin
#   S3_PUBLIC_BASE_URL=http://localhost:9000/<bucket>   (e.g. /civicagent-uploads)
# S3_PUBLIC_BASE_URL is material to retrieval: it is the public base the API
# returns in media URLs, so the bucket must allow anonymous downloads of that
# path (a download-only bucket policy). Set it to the actual MinIO endpoint +
# bucket, and verify with an unauthenticated GET before using in production.
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=us-east-1
S3_SECURE=false
S3_PUBLIC_BASE_URL=http://localhost:9000/civicagent-uploads

# Media / uploads
MAX_IMAGE_MB=10
MAX_VIDEO_MB=50
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp,image/gif
ALLOWED_VIDEO_TYPES=video/mp4,video/webm,video/quicktime

# CORS
CORS_ORIGINS=http://localhost:3000

# ----- GIS / Ward detection & spatial intelligence (Part 10) -----
# Reverse geocoding uses OpenStreetMap's public Nominatim service (no API key).
# It is subject to fair-use rate limits; lookups degrade gracefully on failure.
GIS_BASE_URL=https://nominatim.openstreetmap.org
GIS_NOMINATIM_USERAGENT=CivicAgent/0.1 (civic-complaints-demo)
GIS_NOMINATIM_TIMEOUT_SECONDS=8.0
GIS_NOMINATIM_MAX_RETRIES=2
GIS_DEFAULT_RADIUS_M=500
GIS_MAX_RADIUS_M=5000
GIS_CRITICAL_RADIUS_M=1500
GIS_DEMO_LABEL=DEMO DATA

# ----- Real Nearby Infrastructure Data System (Part 35) -----
# Verified-facility registry + registry-aware nearby lookup backed by real
# OpenStreetMap data (see geographic lookups above). Records are persisted to
# PostGIS `critical_locations` with provenance and an explicit data-quality
# state; no demo placeholders are ever passed off as real facilities.
# Default nearby search radius (metres) when a client omits one.
INFRASTRUCTURE_SEARCH_RADIUS_METERS=500
# Optional Overpass endpoint override for the bulk registry ingestion. Leave
# empty to reuse GIS_OVERPASS_URL (plus its mirrors). Note: many public mirrors
# are unreliable on ward-bbox queries; maps.mail.ru/osm/tools/overpass is the
# most dependable mirror for Pune.
OVERPASS_URL=
# Redis cache TTL (seconds) for registry-aware nearby answers. A cache hit
# always reflects a genuine resolved answer — never a failed lookup.
INFRASTRUCTURE_CACHE_TTL_SECONDS=3600
# Max real records fetched per category per ward during a registry sync.
INFRASTRUCTURE_IMPORT_LIMIT_PER_CATEGORY=150
# Bulk-sync budget (ward-bbox ingestion is heavier than per-request lookups):
# per-request timeout (seconds), retries per mirror, and how many wards x
# categories run concurrently. Lower the concurrency (1-2) against a flaky
# public mirror to avoid 504 rate-limiting.
INFRASTRUCTURE_IMPORT_TIMEOUT_SECONDS=60
INFRASTRUCTURE_IMPORT_MAX_RETRIES=2
INFRASTRUCTURE_IMPORT_CONCURRENCY=3

# ----- Context Enrichment Agent (Part 11) -----
# Weather comes from Open-Meteo's public forecast API. It is free and requires
# NO API key for /v1/forecast (an `apikey` is only required by the separate
# commercial tier) — do not add one here.
WEATHER_BASE_URL=https://api.open-meteo.com/v1/forecast
# Per-request timeout (seconds) and retry budget for Open-Meteo calls.
WEATHER_TIMEOUT_SECONDS=10.0
WEATHER_MAX_RETRIES=2
# Number of forecast days requested (1..16) for the forecast context.
WEATHER_FORECAST_DAYS=3
# Redis cache TTL (seconds) for weather responses. On a cache hit the upstream
# call is skipped; a hit is labelled `cached=true`. When Redis is unreachable the
# agent falls back to a live call (never fails).
WEATHER_CACHE_TTL_SECONDS=1800
# Set to false to disable the external cache entirely.
WEATHER_CACHE_ENABLED=true
# Key namespace used for all context external-cache keys.
CONTEXT_CACHE_NAMESPACE=civicagent:context
# Historical-complaint volume context: lookback window (hours) + radius (metres).
CONTEXT_HISTORICAL_WINDOW_HOURS=168.0
CONTEXT_HISTORICAL_RADIUS_M=1000.0

# ----- Dynamic Priority & Risk Engine (Part 12) -----
# Deterministic weighted scoring; the engine NEVER lets an LLM set the numeric
# score. Each input is normalized to 0..1 then weighted; score = weighted sum
# over present inputs * 100, rounded to an integer in 0..100.
PRIORITY_WEIGHT_SEVERITY=0.30
PRIORITY_WEIGHT_WEATHER=0.10
PRIORITY_WEIGHT_LOCATION=0.15
PRIORITY_WEIGHT_CROWD=0.20
PRIORITY_WEIGHT_HISTORY=0.10
PRIORITY_WEIGHT_TIME=0.15
# Bucket boundaries (inclusive upper cutoff):
# [80,100]->P1_CRITICAL, [60,80)->P2_HIGH, [40,60)->P3_MEDIUM, [0,40)->P4_LOW.
PRIORITY_THRESHOLD_P1=80.0
PRIORITY_THRESHOLD_P2=60.0
PRIORITY_THRESHOLD_P3=40.0
# A recomputation is flagged "changed" (and recorded in history) when the score
# moves by at least this many points.
PRIORITY_CHANGE_THRESHOLD=15.0
# Weather / population / complaint / history / time normalization bands.
PRIORITY_WEATHER_RAIN_MM=5.0
PRIORITY_POPULATION_BAND=1000.0
PRIORITY_COMPLAINT_BAND=10.0
PRIORITY_HISTORY_BAND=15.0
PRIORITY_TIME_BAND_HOURS=168.0

# ----- Department Routing Agent (Part 13) -----
# Deterministic rule-based department assignment over the seven fixed departments
# (WATER, ROADS, ELECTRICAL, WASTE, DRAINAGE, PARKS, EMERGENCY_DISASTER). The
# engine NEVER lets an LLM choose the department.
ROUTING_CONFIDENCE_UNKNOWN=0.30
ROUTING_CONFIDENCE_KNOWN=0.92
ROUTING_CONFIDENCE_MULTI=0.85
ROUTING_CONFIDENCE_PRIORITY_BOOST=0.03
ROUTING_MAX_SECONDARY_DEPARTMENTS=2
ROUTING_OVERRIDE_ENABLED=true

# ----- Notifications / Email (Part 21) -----
# Inbound notifications are stored, listed and pushed over /api/v1/notifications
# and the per-user /ws/notifications socket regardless of this section. Email is
# an optional out-of-band channel: keep the console provider (no creds, logs to
# stdout) or switch to SMTP after supplying credentials. Never commit real
# credentials.
EMAIL_PROVIDER=console
# From-address used on every outgoing email.
EMAIL_FROM=CivicAgent <no-reply@civicagent.local>
# When true (and a provider is configured), channel="email" notifications are
# also emailed. Off by default; flip on only after SMTP credentials exist.
NOTIFICATIONS_EMAIL_ENABLED=false
# SMTP server settings (only used when EMAIL_PROVIDER=smtp).
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=your-smtp-user-here
SMTP_PASSWORD=your-smtp-password-here
# Use STARTTLS when connecting (safe default for the common submission port).
SMTP_TLS=true
# Per-connection timeout for SMTP (seconds).
SMTP_TIMEOUT_SECONDS=30.0

# Development
DEBUG=false