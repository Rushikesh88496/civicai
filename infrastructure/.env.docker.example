# ===========================================================================
# CivicAgent — Compose environment reference.
#
# Copy to infrastructure/.env and fill in the REQUIRED values.
#   cp .env.docker.example .env
#
# Or point Compose at your existing repo-root .env file:
#   docker compose --env-file ../.env up -d
# ===========================================================================

# --- REQUIRED ---
# Generate one:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# At least 32 bytes for HS256. A missing value fails `docker compose up` fast.
JWT_SECRET=

# --- Database (only reachable inside the Compose network) ---
POSTGRES_DB=civicagent
POSTGRES_USER=civicagent
POSTGRES_PASSWORD=civicagent
# Optional: override the full DSN (URL-encode special chars, e.g. '#' -> %23).
# DATABASE_URL=postgresql+asyncpg://civicagent:password@postgres:5432/civicagent

# --- Backend ---
DEBUG=false
# Demo seed is for dev/test only. Never enable in production.
SEED_DEMO_DATA=false
CORS_ORIGINS=http://localhost:3000

# --- AI / LLM (Groq) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
VISION_PROVIDER=groq
VISION_MODEL=qwen/qwen3.8-27b

# --- Storage ---
# "local" writes uploads to the uploads_data volume.
STORAGE_BACKEND=local
STORAGE_BUCKET=civicagent-uploads

# --- Notifications email (console provider needs no credentials) ---
EMAIL_PROVIDER=console
EMAIL_FROM=CivicAgent <no-reply@civicagent.local>
NOTIFICATIONS_EMAIL_ENABLED=false

# --- Frontend ---
# Inlined into the browser bundle at build time. Must be reachable from the
# visitor's browser. Override when the API sits behind a domain/reverse proxy.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Host ports ---
BACKEND_PORT=8000
FRONTEND_PORT=3000
# dev override maps Postgres here (avoids a local PG on 5432).
POSTGRES_HOST_PORT=5433

# --- Optional MinIO/S3 (see docker-compose.minio.yml + backend/.env.example) ---
# MINIO_ROOT_USER=minioadmin
# MINIO_ROOT_PASSWORD=minioadmin
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=http://minio:9000
# S3_PUBLIC_BASE_URL=http://localhost:9000/civicagent-uploads